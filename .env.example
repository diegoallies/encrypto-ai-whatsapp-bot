# ─── Owner identity (filled by `npm run setup` or first-run WhatsApp onboarding) ──
ASSISTANT_NAME=Encrypto AI
OWNER_NAME=
OWNER_FIRST_NAME=
OWNER_PHONE=
# WhatsApp JID(s) that count as the owner. Auto-derived from OWNER_PHONE at setup.
OWNER_JID=
OWNER_PHONE_JID=
OWNER_JIDS=
OWNER_CITY=
OWNER_TIMEZONE=

# Comma-separated WhatsApp JIDs allowed to message the bot.
# Format: <country-code><number>@s.whatsapp.net   (no +, no spaces)
# Example for +1 (415) 555-1234:  14155551234@s.whatsapp.net
# Easiest way to find yours: leave this blank, start the bot, message it from
# your phone, and copy the JID it prints in the console.
ALLOWED_JIDS=

# Directory the bot's tools operate inside. Defaults to the current working dir.
# Set this to sandbox the bot to a specific folder.
WORK_DIR=

# Optional log level for Baileys (silent | warn | info | debug). Default: warn
LOG_LEVEL=warn

# ─── AI provider ─────────────────────────────────────────────────────────────
# claude = Claude Code Agent SDK with local tools/subscription support.
# openai/chatgpt/codex = OpenAI-compatible Responses API token mode.
# codex-cli = shell out to `codex exec` for local terminal/tool use.
AI_PROVIDER=claude

# Claude mode: leave unset to use your Claude Code subscription.
# Set to a key from console.anthropic.com to use Anthropic API billing.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# OpenAI/ChatGPT/Codex token mode. Use AI_PROVIDER=openai, chatgpt, or codex.
# OPENAI_API_KEY=
# CODEX_API_KEY=              # optional; leave blank to use `codex login` subscription auth
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_MAX_OUTPUT_TOKENS=

# Codex CLI mode. Install with: npm install --global @openai/codex
# AI_PROVIDER=codex-cli
# CODEX_API_KEY=
# CODEX_MODEL=               # optional; leave blank for Codex CLI default
# CODEX_CLI_BIN=codex
# CODEX_CLI_SANDBOX=workspace-write
# CODEX_CLI_TIMEOUT_MS=300000
# CODEX_CLI_ARGS=

# ─── Web UI ──────────────────────────────────────────────────────────────────
# Local dashboard. Set WEB_UI=0 to disable.
WEB_UI=1
WEB_HOST=127.0.0.1
WEB_PORT=7777
# If you reverse-proxy via Caddy/etc, set the public URL for the navbar display.
# PUBLIC_URL=https://encrypto.home

# ─── Streaming replies ───────────────────────────────────────────────────────
# Send Claude's reply chunk-by-chunk as it generates (default on). Set to 0
# to wait for the full reply before sending.
STREAM_REPLIES=1
# Tune chunk sizes — bigger = fewer, longer WhatsApp messages.
# STREAM_MIN_CHARS=280     # min chars before flushing at a sentence/paragraph boundary
# STREAM_MAX_CHARS=1400    # force-flush at this size
# STREAM_MIN_GAP_MS=900    # min ms between flushes (throttle)

# ─── Video understanding ─────────────────────────────────────────────────────
# When a video arrives, the bot extracts keyframes with ffmpeg and transcribes
# the audio with whisper, then hands both to Claude.
# VIDEO_MAX_FRAMES=6        # cap on keyframes per clip (1..12); short clips get fewer
# VIDEO_TRANSCRIBE=1        # 0 to skip whisper for videos (silent / save time)
# VIDEO_FRAME_QUALITY=4     # ffmpeg -q:v scale (2 best, 31 worst)

# ─── Voice transcription ─────────────────────────────────────────────────────
# Uses the openai-whisper Python CLI (pip install --user openai-whisper).
# WHISPER_MODEL=tiny       # tiny|base|small|medium|large (bigger = slower + accurate)
# WHISPER_LANGUAGE=en
# WHISPER_TIMEOUT_MS=120000

# ─── Auth backup ─────────────────────────────────────────────────────────────
# Daily tarball of auth_info_baileys/ to ~/wa-bot-backups/. Set to 0 to disable.
AUTH_BACKUP=1
AUTH_BACKUP_KEEP=7

# ─── Per-JID rate-limit text ─────────────────────────────────────────────────
# Custom cut-off message per JID. Single pipe separates entries (so colons and
# commas inside messages are fine). Example:
#   DAILY_MSG_LIMIT_TEXT_PER_JID=27670342493@s.whatsapp.net:That's all dad, chat tomorrow!|27662025339@s.whatsapp.net:Love you, more tomorrow x
# DAILY_MSG_LIMIT_TEXT_PER_JID=

# ─── CrowdSec → WhatsApp ─────────────────────────────────────────────────────
# Polls the CrowdSec container for new decisions and forwards them.
# CROWDSEC=1
# CROWDSEC_CONTAINER=crowdsec
# CROWDSEC_INTERVAL_MS=900000     # 15 minutes

# ─── TTS voice replies (Piper) ───────────────────────────────────────────────
# When the user sends a voice note, reply with a voice note too.
# Install: pip install --user piper-tts  +  download a voice model.
# VOICE_REPLY=1
# PIPER_VOICE=/home/encrypto27/piper-voices/en_US-lessac-medium.onnx
# TTS_MAX_CHARS=1500

# ─── Cost guard rails ────────────────────────────────────────────────────────
# Daily token budget. Behavior:
#   < 90% of soft   →  normal replies
#   ≥ 90% of soft   →  TERSE MODE (Claude switches to 1–2 sentence replies, skips
#                      tools unless essential) — stays online but cheap
#   ≥ soft          →  one-shot DM warning to owner + stays in terse mode
#   ≥ hard          →  refuses new Claude calls (owner bypasses)
# DAILY_TOKEN_SOFT_LIMIT=200000
# DAILY_TOKEN_HARD_LIMIT=500000

# ─── Owner focus mode ────────────────────────────────────────────────────────
# When owner says "stop", "drop everything", "focus on me", etc. the bot
# silences all non-owner chats for this duration (default 30 min). Owner can
# end early with "resume" / "back to normal".
# FOCUS_TTL_MS=1800000

# ─── Heartbeat wake-up ───────────────────────────────────────────────────────
# Periodic self-check where Claude re-reads MEMORY.md / today's daily note /
# journal and surfaces ONE thing worth flagging — or stays silent. Costs ~2k
# tokens per wake-up. Default off.
# WAKE_UP=1
# WAKEUP_INTERVAL_MS=14400000     # 4 hours

# ─── Rate-limit work blocks ──────────────────────────────────────────────────
# OpenClaw pattern: schedule heavy AI work in predictable windows so quota
# refills during quiet hours. Cron expressions:
#   DAILY_DIGEST_CRON=0 7 * * *      Daily briefing at 07:00
#   --cron "0 3 * * *"               Heavy nightly tasks at 03:00 (when scheduled)
#   --cron "0 13 * * *"              Afternoon block at 13:00
# Just convention — use these hours in your /remind and /cron entries.

# ─── Daily digest ────────────────────────────────────────────────────────────
# When enabled, a recurring scheduled prompt fires at DAILY_DIGEST_CRON and
# DM's a digest (today's jobs, unread emails, Saved items) to ALLOWED_JIDS[0].
# DAILY_DIGEST=1
# DAILY_DIGEST_CRON=0 7 * * *
# DAILY_DIGEST_PROMPT=    # override the default prompt entirely

# ─── WhatsApp history (wacli) ────────────────────────────────────────────────
# Path to the wacli store directory. When set, the bot auto-syncs the local
# message DB every WACLI_SYNC_INTERVAL_MS (default 30m). Authenticate once:
#   wacli --store ~/.wacli-diego auth
# WACLI_STORE=/home/encrypto27/.wacli-diego
# WACLI_SYNC_INTERVAL_MS=1800000

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Global daily cap for replies (0 = unlimited).
DAILY_MSG_CAP_DEFAULT=0
# Per-JID caps, comma-separated.  Example: 27670342493@s.whatsapp.net:15
# DAILY_MSG_CAP_PER_JID=

# ─── Heartbeat plugins (background checks) ───────────────────────────────────
# Email check via himalaya CLI. Forwards unread summary to ALLOWED_JIDS[0].
# HEARTBEAT_EMAIL_CHECK=1
# HEARTBEAT_EMAIL_INTERVAL=30m
# HIMALAYA_ACCOUNT=

# ─── ntfy bridge ─────────────────────────────────────────────────────────────
# Subscribe to a ntfy topic and forward to ALLOWED_JIDS[0].
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# ─── Webhook auth ────────────────────────────────────────────────────────────
# Shared secret for POST /webhook/alert. Leave unset to disable auth (NOT recommended if WEB_HOST != 127.0.0.1).
# WEBHOOK_SECRET=

# ─── Allowlist patterns (NEW) ────────────────────────────────────────────────
# ALLOWED_JIDS supports glob patterns alongside exact JIDs:
#   *@s.whatsapp.net   — every DM (DANGEROUS, anyone can shell-as-you)
#   *@g.us             — every group you're invited to
# Mix freely:  ALLOWED_JIDS=14155551234@s.whatsapp.net,*@g.us

# ─── Ack reactions ───────────────────────────────────────────────────────────
# React ⏳ on receipt, ✅ on done, ❌ on error. Set to 0 to disable.
ACK_REACTIONS=1
# ACK_RECEIVED=⏳
# ACK_DONE=✅
# ACK_ERROR=❌

# ─── Streaming as edits ──────────────────────────────────────────────────────
# Default streaming (off) sends each chunk as a new WhatsApp message. Set to 1
# to edit one message in place as text arrives, only starting a new one when
# the message overflows ~3500 chars. Cleaner UX, more API calls.
# STREAM_AS_EDITS=0

# ─── Budget tracker (budget.home) ────────────────────────────────────────────
# /budget command + Claude integration with the Next.js budget tracker.
# Read-only — there's no transactions write endpoint in the app yet.
BUDGET_URL=http://127.0.0.1:3201
BUDGET_USER=Dudas
BUDGET_PASS=

# ─── URL unfurler ────────────────────────────────────────────────────────────
# Auto-summarise links Diego pastes (just a URL, or URL + a couple words).
# Uses Claude + WebFetch.
URL_UNFURL=1

# ─── MCP servers (optional tool servers Claude can call) ─────────────────────
# Point to a JSON file with the same schema Claude Code uses:
#   { "mcpServers": { "filesystem": { "command": "npx", "args": ["@…"] } } }
# MCP_CONFIG=mcp.json
